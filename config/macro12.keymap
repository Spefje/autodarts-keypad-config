#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // Raderna kopplade till dina stift: 2, 7, 6, 4
        row-gpios
            = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Stift 2 -> P0.13
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Stift 7 -> P0.15
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Stift 6 -> P0.17
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Stift 4 -> P0.20
            ;

        // Kolumnerna kopplade till dina stift: 3, 1, 5
        col-gpios
            = <&gpio0 22 GPIO_ACTIVE_HIGH> // Stift 3 -> P0.22
            , <&gpio0 24 GPIO_ACTIVE_HIGH> // Stift 1 -> P0.24
            , <&gpio1 0  GPIO_ACTIVE_HIGH> // Stift 5 -> P1.00
            ;
    };

    keymap {
        compatible = "zmk,keymap";

        // LAGER 0: Standardläge (Vanlig Numpad för poängkorrigering)
        default_layer {
            bindings = <
                &kp KP_N7    &kp KP_N8    &kp KP_N9
                &kp KP_N4    &kp KP_N5    &kp KP_N6
                &kp KP_N1    &kp KP_N2    &kp KP_N3
                &mo 1        &kp KP_N0    &kp BSPC
            >;
        };

        // LAGER 1: Funktionsläge (Håll in knappen längst ner till vänster)
        function_layer {
            bindings = <
                &kp F1       &kp F2       &kp F3 
                &kp UP       &kp F5       &kp F6 
                &kp LEFT     &kp DOWN     &kp RIGHT     
                &trans       &kp F11      &kp F12 

            >;
        };
    };
};
